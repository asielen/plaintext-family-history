# Your archive is plain text. If you keep it in git, these rules stop a
# checkout on another machine from silently rewriting line endings under you.
* text=auto
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
.gitignore text eol=lf

# The POSIX launcher must stay LF in the working tree on every platform. A
# checkout that rewrote it to CRLF would ship a shell script /bin/sh cannot run
# ("bad interpreter"), and would change its bytes out from under the checksum
# recorded in .plaintext-version - so every later update would see the stock
# launcher as customized and keep backing it up.
fha text eol=lf
