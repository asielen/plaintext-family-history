{
  "manifest_version": 3,
  "name": "Seen It: Newspapers.com, Ancestry, FamilySearch, Find a Grave",
  "version": "0.12.0",
  "description": "Marks the newspaper pages, records and memorials you have already opened, ruled out, or attached to your tree on Newspapers.com, Ancestry, FamilySearch and Find a Grave, and logs your searches.",
  "permissions": [
    "storage",
    "history",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.newspapers.com/*",
    "https://www.ancestry.com/*",
    "https://www.familysearch.org/*",
    "https://www.findagrave.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.newspapers.com/*"
      ],
      "js": [
        "cliplist.js",
        "searchrun.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ancestry.com/*"
      ],
      "js": [
        "content-ancestry.js"
      ],
      "css": [
        "content-ancestry.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.familysearch.org/*"
      ],
      "js": [
        "content-familysearch.js"
      ],
      "css": [
        "content-ancestry.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.findagrave.com/*"
      ],
      "js": [
        "content-findagrave.js"
      ],
      "css": [
        "content-ancestry.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Seen It"
  },
  "key": "",
  "externally_connectable": {
    "ids": [
      "*"
    ]
  },
  "optional_permissions": [
    "nativeMessaging"
  ]
}
