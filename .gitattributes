* text=auto
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
# The checksum-stability rule has to cover itself: without this line,
# .gitattributes falls through to `* text=auto` like any other untracked
# extension, so a Windows checkout normalizes it to CRLF and manifest.json's
# regenerated hash for it disagrees with the LF blob every other platform
# computes - a pristine stock file then reads as user-modified on install/
# update-tools (scaffold.py's checksum compare). Same defect shape as #57:
# a rule that fails to cover the thing it's about, corrupting committed data
# nothing checks.
.gitattributes text eol=lf
# Windows launchers: CRLF, matching what cmd.exe expects and what a Windows
# checkout already produces. Pinned so manifest.json's checksum is stable on
# every platform instead of falling through to autocrlf.
*.cmd text eol=crlf

# The POSIX launcher must stay LF in the working tree on every platform: a
# checkout that rewrote it to CRLF would ship a shell script /bin/sh cannot run,
# and would change its bytes out from under manifest.json's checksum.
fha text eol=lf
